NEXT_PUBLIC_SITE_URL=https://kayahealingspa.com.np
SPA_PUBLIC_URL=https://kayahealingspa.com.np

# Resend — booking confirmations (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=booking@kayahealingspa.com.np

# Secret for PDF download tokens (optional; falls back to ORBIT_PASSKEY in dev)
BOOKING_PDF_SECRET=

# Optional SMTP (not used for booking confirmations — Resend only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Optional: Google Search Console HTML tag verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
ORBIT_PASSKEY=
