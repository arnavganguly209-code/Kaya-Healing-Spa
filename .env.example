NEXT_PUBLIC_SITE_URL=https://kayahealingspa.com.np
SPA_PUBLIC_URL=https://kayahealingspa.com.np

# Booking confirmation email — Resend (recommended for production)
BOOKING_EMAIL_PROVIDER=resend
RESEND_API_KEY=
BOOKING_FROM_EMAIL=booking@kayahealingspa.com.np
BOOKING_FROM_NAME=Kaya Healing Spa

# Optional SMTP fallback (only when BOOKING_EMAIL_PROVIDER=smtp)
SMTP_HOST=mail.globalorbitmail.cloud
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Kaya Healing Spa
SMTP_SECURE=false

# PDF download tokens (required in production)
BOOKING_PDF_SECRET=

# Optional tax rate for invoices (percent, e.g. 0 or 13). Never hardcode legal rates in code.
BILLING_TAX_RATE_PERCENT=0

# Optional: Google Search Console HTML tag verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
ORBIT_PASSKEY=

# Optional payment gateway (not required for pay-at-spa)
# GLOBAL_IME_MERCHANT_ID=
# GLOBAL_IME_API_KEY=
# GLOBAL_IME_API_SECRET=
